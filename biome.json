{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "noLabelWithoutControl": "off", "useButtonType": "off" },
      "performance": { "noImgElement": "off" },
      "suspicious": { "noDocumentCookie": "off" }
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  }
}